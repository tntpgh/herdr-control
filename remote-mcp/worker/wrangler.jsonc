{
  // herdr-mcp — authenticated remote MCP over herdr-control status.
  // Deploy: see ../README.md "Deploy". Secrets (never committed):
  //   wrangler secret put INGEST_KEY   (same value as HERDR_MCP_INGEST_KEY in
  //                                     ~/.config/op/launchd-secrets.env)
  "name": "herdr-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // global_fetch_strictly_public: SSRF guard the OAuth provider requires
  // before it will fetch Client ID Metadata Documents.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [{ "pattern": "herdr-mcp.teamthurber.com", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "cfeae87a64f4409a99d455cfbcc224bc" }],
  "durable_objects": { "bindings": [{ "name": "HERDR_STATE", "class_name": "HerdrState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HerdrState"] }],
  "vars": {
    "PUBLIC_URL": "https://herdr-mcp.teamthurber.com",
    "ACCESS_TEAM_DOMAIN": "thurberteam.cloudflareaccess.com",
    // AUD of the path-scoped Access app "herdr-mcp-authorize" (scripts/provision.sh).
    "ACCESS_AUD": "8c1120f68ebc19debcb90cf85642449fa8d37064d0240d7962dc6a54c2e707eb",
    "ALLOWED_EMAILS": "tnt@teamthurber.com",
    "STALE_AFTER_S": "90",
    // On since 2026-10-01 (Terrence, go-live form for messaging). Set "false" and
    // redeploy to turn it off: new sends are refused and every queued message is
    // cancelled on the next sync. The Mac has its own switch (install.sh).
    "MESSAGING_ENABLED": "true",
    // Remote task lifecycle (start_task/cancel_task/resume_task). On since
    // PR #211's security review approved (round 5, 3d0ca83) and the live
    // strict-posture repro passed. Set "false" and redeploy to turn it off;
    // the Mac has its own switch, HERDR_MCP_TASKS (install.sh
    // --remote-mcp-tasks), and either off refuses new starts.
    "TASKS_ENABLED": "true",
    // ZERO-LOOP-001 #5, design-approved only (Terrence, form
    // 20261002T142819-8748): send_owner_message/get_owner_message_status/
    // get_owner_reply, addressed to a named long-lived owning session. Ship
    // OFF until a SEPARATE go-live consent turned it on: Terrence, hub form
    // 20261003T141855-8747 (enable: on, owners conductor + herdr-control-dots).
    // Same two-switch shape as messaging/tasks -- the Mac's own switch is
    // HERDR_MCP_OWNER_INBOX (install.sh --remote-mcp-owner-inbox).
    "OWNER_INBOX_ENABLED": "true",
    // Consumer positions are approved for build/review, not activation.
    "EVENT_CONSUMERS_ENABLED": "false",
    // The commit this deploy was built from. provision.sh overrides it with
    // `--var BUILD_SHA:<sha>` from a clean, pushed tree; /healthz reports it.
    "BUILD_SHA": "unstamped"
  },
  "observability": { "enabled": true }
}
