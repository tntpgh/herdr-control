<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.herdr-control.remote-mcp</string>
	<key>ProgramArguments</key>
	<array>
		<!-- One publisher tick: push herdr status to herdr-mcp.teamthurber.com,
		     deliver the messages it queued (remote-mcp/README.md). It reads its
		     one credential, HERDR_MCP_INGEST_KEY, from
		     ~/.config/op/launchd-secrets.env with the same literal parser as the
		     hub, and never runs `op`, so no service-account file is sourced.
		     Render (install.sh --remote-mcp): __REMOTE_MCP_PYTHON__ -> an
		     explicit, versioned, absolute python3 (launchd/resolve-hub-python.sh,
		     the SAME resolver the hub plist pins — publisher.py opens the
		     registry sqlite directly and imports tasks.py, so it needs the same
		     pin, NEVER `/usr/bin/env python3`: that resolves through PATH at
		     launchd load time with none of the shell's environment, and on a
		     machine where Homebrew's generic `python3` symlink is missing it
		     silently lands on the CLT's /usr/bin/python3 3.9.6 while an
		     interactive shell's `python3` is 3.14), __REMOTE_MCP_PY__ -> the
		     DEPLOYED app worktree's remote-mcp/publisher.py, __LOG_PATH__ ->
		     ~/Library/Logs/com.herdr-control.remote-mcp.log. -->
		<string>__REMOTE_MCP_PYTHON__</string>
		<string>__REMOTE_MCP_PY__</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<!-- Same belt as the hub: nothing here calls `op`, but if a descendant
		     ever does it must fail fast, never paint a Touch ID prompt. -->
		<key>OP_BIOMETRIC_UNLOCK_ENABLED</key>
		<string>false</string>
		<!-- The Mac's own messaging switch: "1" only when installed with
		     install.sh --remote-mcp-messaging; anything else refuses every
		     leased message. Re-run without the flag to turn it off. -->
		<key>HERDR_MCP_MESSAGING</key>
		<string>__REMOTE_MCP_MESSAGING__</string>
		<!-- Same shape, for the remote task lifecycle (start_task/cancel_task/
		     resume_task): "1" only with install.sh --remote-mcp-tasks; anything
		     else refuses a new start command and cancels every queued one. -->
		<key>HERDR_MCP_TASKS</key>
		<string>__REMOTE_MCP_TASKS__</string>
		<!-- Same shape again, for send_owner_message (ZERO-LOOP-001 #5,
		     design-approval-only): "1" only with install.sh
		     --remote-mcp-owner-inbox; anything else refuses a new queued owner
		     message (owner_inbox_disabled) and never scans for replies. This is
		     independent of the Worker's own OWNER_INBOX_ENABLED scope switch --
		     both must be on for a message to actually reach a pane. -->
		<key>HERDR_MCP_OWNER_INBOX</key>
		<string>__REMOTE_MCP_OWNER_INBOX__</string>
		<!-- research-task-closure defect 2 (2026-10-04): names a standing
		     conductor pane spawn-task.sh falls back to (its own env read,
		     ~line 390) when a spawned task has no live interactive conductor
		     of its own -- without this, every remote-mcp task got
		     conductor_unknown/conductor_unconfigured, and an escalation had
		     nowhere fast to go until the owner-inbox/human-notify fallback
		     (herdr-action.sh). Both empty (the default) is unchanged
		     behaviour -- that fallback is skipped exactly as before, never a
		     spawn failure. Set with install.sh
		     --remote-mcp-conductor-pane=<pane_id> (resolves BIRTH itself from
		     the live pane at install time; refuses if the pane is not a live
		     agent pane). BIRTH is spawn-task.sh's own liveness proof
		     (terminal_id) -- a plain pane_id survives herdr recycling it to an
		     unrelated occupant, BIRTH does not, so a stale pair safely
		     degrades to the same fallback as unset rather than messaging a
		     stranger's pane. -->
		<key>HERDR_MCP_CONDUCTOR_PANE</key>
		<string>__REMOTE_MCP_CONDUCTOR_PANE__</string>
		<key>HERDR_MCP_CONDUCTOR_BIRTH</key>
		<string>__REMOTE_MCP_CONDUCTOR_BIRTH__</string>
		<!-- tmp/in/BRIEF.md: turn on result-availability delivery. Off until
		     now, publisher.py's result_availability_tick() (~1298) returned
		     None every tick -- finished owner results were never observed or
		     noticed; a canary needed a manual tick. The same owner-lease gate
		     also drives owner_lease_renew_tick() (~1259), which is generic
		     over EVERY registered owner_projects label already (lib/
		     owner_lease_renew.py renew_all_due(), one SELECT ORDER BY label,
		     no code change needed) -- turning the gate on here is what makes
		     the registered `conductor` label (owner_projects conductor ->
		     tntpgh/herdr-control, lifecycle_end +24h) actually get renewed
		     within its bound instead of just sitting on its gen1 3600s lease.
		     Paths are the fixed single-machine herdr-control state root
		     (~/.local/state/herdr/owner-dispatch/), the SAME store and the
		     SAME literal values the hub's rendered LaunchAgent env already
		     uses -- not install.sh-rendered, matching how OP_BIOMETRIC_UNLOCK_
		     ENABLED/HERDR_EDGE_PEER_ANSWER above are fixed infra constants in
		     that template, not per-invocation flags like the Mac-switch keys
		     above. Deliberately WITHOUT HERDR_OWNER_DISPATCH / HERDR_OWNER_
		     DISPATCH_AUTH_DB: those gate the separate owner-dispatch.py CLI
		     and queue-supervisor.py entry points, neither of which this tick
		     (grep-checked) ever imports or reads an env var from -- adding
		     them here would be dead weight on a key this publisher never
		     consults. -->
		<key>HERDR_RESULT_AVAILABILITY</key>
		<string>1</string>
		<key>HERDR_RESULT_AVAILABILITY_DB</key>
		<string>/Users/thurbs/.local/state/herdr/owner-dispatch/result-availability.sqlite3</string>
		<key>HERDR_RESULT_AVAILABILITY_JOURNAL</key>
		<string>/Users/thurbs/.local/state/herdr/owner-dispatch/journal</string>
		<key>HERDR_RESULT_AVAILABILITY_ROOTS</key>
		<string>thurber-os=/Users/thurbs/.local/state/herdr/owner-dispatch/handoffs/thurber-os</string>
		<key>HERDR_OWNER_LEASE_DELIVERY</key>
		<string>1</string>
		<key>HERDR_OWNER_LEASE_DB</key>
		<string>/Users/thurbs/.local/state/herdr/owner-dispatch/owner-lease.sqlite3</string>
		<key>HERDR_OWNER_LEASE_RENEW</key>
		<string>1</string>
	</dict>
	<!-- 15 s: the Worker reports `disconnected` after 90 s without a sync,
	     so six missed ticks in a row are what it takes to go dark. -->
	<key>StartInterval</key>
	<integer>15</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__LOG_PATH__</string>
	<key>StandardErrorPath</key>
	<string>__LOG_PATH__</string>
</dict>
</plist>
