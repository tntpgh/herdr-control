# Dockerfile.isolated-worker — trusted build of the herdr isolated smart-worker image.
#
# Build (no context needed; nothing from the checkout is copied in):
#
#   docker build --platform linux/arm64 -t herdr-isolated-worker:18.1.10 -f Dockerfile.isolated-worker "$(mktemp -d)"
#
# What this image is:
#   * Debian bookworm-slim (dated tag) + the tools an omp worker needs offline:
#     git, python3, ripgrep, curl (for in-container smoke of "network is
#     blocked"), jq, procps.
#   * omp 18.1.10 Linux ARM64 single-file release, SHA256-pinned from the
#     GitHub release metadata (see /tmp/herdr-sandbox-research.txt). No
#     installer script, no npm/bun bootstrap, no runtime download.
#   * An entrypoint that seeds the worker's tmpfs home from the read-only
#     /herdr/config mount (models.yml routing everything to the relay), sets a
#     git identity, optionally commits the /workspace snapshot as a baseline
#     so the worker can `git diff` its own work, then execs omp.
#   * The label dev.herdr.isolated-worker=omp-18.1.10 that isolated-worker.py
#     REQUIRES before it will run an image, and runs by image ID afterwards.
#
# What this image is NOT: it holds no credentials, no host config, no
# extensions, no project hooks, and it is never pulled by the orchestrator
# (`--pull never`). Root is only used at build time; runtime is an
# unprivileged UID supplied by the orchestrator together with a generated
# /etc/passwd, so the default USER below only matters for manual runs.
#
# Rebuild whenever the omp pin changes; keep the SHA256 and the label in step
# with OMP_VERSION in isolated-worker.py.

FROM debian:bookworm-20260824-slim

LABEL dev.herdr.isolated-worker="omp-18.1.10" \
      org.opencontainers.image.title="herdr isolated smart worker" \
      org.opencontainers.image.description="omp 18.1.10 in a credential-free, network-isolated task container"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl libstdc++6 libgcc-s1 git python3 ripgrep jq procps \
 && rm -rf /var/lib/apt/lists/*

# Pinned release binary. The checksum is the one published for
# omp-linux-arm64 on the v18.1.10 GitHub release; a mismatch fails the build.
RUN curl -fsSL --connect-timeout 10 --max-time 300 \
      https://github.com/can1357/oh-my-pi/releases/download/v18.1.10/omp-linux-arm64 \
      -o /usr/local/bin/omp \
 && echo 'aba7beb612459789e539db980c95680c26d26ca0d67776152fce70cc6e1dac06  /usr/local/bin/omp' | sha256sum -c - \
 && chmod 0755 /usr/local/bin/omp \
 && /usr/local/bin/omp --version

# omp ships its native addon EMBEDDED in the release binary and extracts it
# to $HOME/.omp/natives/<ver>/ on first use (verified offline: --network none,
# rc=0). At run time the worker's home is a `noexec` tmpfs, so the extracted
# copy cannot be mmapped ("failed to map segment") and omp then tries a
# network download the isolated network blocks. Extract it here at build
# time, pin its digest (deterministic — it comes out of the pinned binary),
# and place it at /usr/local/bin, which is on omp's addon search path and on
# the read-only root. Nothing is downloaded for this step.
RUN mkdir -p /tmp/build-home \
 && HOME=/tmp/build-home /usr/local/bin/omp read /etc/hostname >/dev/null \
 && cp /tmp/build-home/.omp/natives/18.1.10/pi_natives.linux-arm64.node /usr/local/bin/pi_natives.linux-arm64.node \
 && echo 'cf63c53f24e51449dfc442092e0746b029c86fb2c523ab45ec08bbaf92192285  /usr/local/bin/pi_natives.linux-arm64.node' | sha256sum -c - \
 && chmod 0755 /usr/local/bin/pi_natives.linux-arm64.node \
 && rm -rf /tmp/build-home

# Mount points must exist before the root filesystem goes read-only at run time.
RUN groupadd -g 1000 worker \
 && useradd -u 1000 -g 1000 -d /home/worker -s /bin/bash -M worker \
 && mkdir -p /home/worker /workspace /herdr/out /herdr/brief /herdr/operator /herdr/config /herdr/relay \
 && chown 1000:1000 /home/worker /workspace /herdr/out

COPY <<'EOF' /usr/local/bin/herdr-worker-entry
#!/bin/sh
# herdr-worker-entry — seed the tmpfs home, then exec omp with the caller's args.
# Runs as the unprivileged worker UID. Everything it reads under /herdr/config
# is a read-only mount generated by isolated-worker.py on the host.
set -eu
: "${HOME:=/home/worker}"
agent="$HOME/.omp/agent"
mkdir -p "$agent"
chmod 0700 "$HOME" "$HOME/.omp" "$agent" 2>/dev/null || true
if [ -f /herdr/config/models.yml ]; then
  cp /herdr/config/models.yml "$agent/models.yml"
  chmod 0600 "$agent/models.yml"
fi
if [ -f /herdr/config/settings.json ]; then
  cp /herdr/config/settings.json "$agent/settings.json"
  chmod 0600 "$agent/settings.json"
fi
git config --global user.name  "herdr isolated worker"
git config --global user.email "someone@example.com"
git config --global init.defaultBranch main
git config --global commit.gpgsign false
git config --global safe.directory /workspace
if [ "${HERDR_WORKER_GIT_INIT:-1}" != "0" ] && [ -d /workspace ] && [ ! -e /workspace/.git ]; then
  if ( cd /workspace \
       && git init -q \
       && git add -A \
       && git commit -q --allow-empty -m "herdr baseline snapshot ${HERDR_SOURCE_COMMIT:-unknown}" ); then
    :
  else
    echo "herdr-worker-entry: baseline git init failed; continuing without a git baseline" >&2
    rm -rf /workspace/.git
  fi
fi
exec /usr/local/bin/omp "$@"
EOF
RUN chmod 0755 /usr/local/bin/herdr-worker-entry

WORKDIR /workspace
ENV HOME=/home/worker \
    OMP_SKIP_SETUP=1 \
    LANG=C.UTF-8
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/herdr-worker-entry"]
