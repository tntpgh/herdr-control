# Copy to ~/.config/herdr-bridge.env and fill in. run-bridge.sh sources this.
#
# Keep real tokens out of git. Either paste them here (chmod 600 the file) or,
# better, resolve them from your secret manager at runtime, e.g.:
#   export SLACK_BOT_TOKEN="$(op read op://secrets/herdr-slack-bridge-bot/credential)"  # 1Password
#   export SLACK_BOT_TOKEN="$(pass show herdr/slack-bot)"                                # pass
# The bridge/herdr-notify just need the vars set in the environment.

export SLACK_BOT_TOKEN="xoxb-...your-bot-token..."     # OAuth & Permissions page
export SLACK_APP_TOKEN="xapp-...your-app-token..."     # Basic Information → App-Level Tokens (connections:write)

# REQUIRED — your Slack member id(s), comma-separated. Fail-closed: only these
# users' messages are delivered. Slack: your avatar → Profile → (⋯) → Copy member ID.
export HERDR_BRIDGE_ALLOW_USERS="U00000000"

# OPTIONAL — restrict to a single channel id (else any channel the bot is in + DMs).
# export HERDR_BRIDGE_CHANNEL="C00000000"
