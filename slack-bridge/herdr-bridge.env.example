# Copy to ~/.config/herdr-bridge.env and fill in. Tokens live in 1Password
# (Secrets vault) — this file only references them, no literal secrets on disk.
# The op service account resolves op:// at runtime via OP_SERVICE_ACCOUNT_TOKEN.
#
# The `:-` guards are load-bearing. Under launchd, `op` hangs FOREVER even with
# OP_SERVICE_ACCOUNT_TOKEN exported: it probes Apple Events / AppData TCC on
# every invocation from a background session (1Password/shell-plugins#606) and
# there is no TTY to answer the prompt. Observed live 2026-09-06 — a plist
# reload left the daemon blocked in `op read` and Slack silently lost every
# alert and every phone approval until it was noticed.
#
# So let the environment win: keep pre-resolved values in a 0600 file the plist
# sources (see com.herdr-control.bridge.plist.template) and the launchd path
# never spawns op at all. An interactive shell with neither var set still
# resolves through 1Password exactly as before.
export SLACK_BOT_TOKEN="${SLACK_BOT_TOKEN:-$(op read op://secrets/herdr-slack-bridge-bot/credential)}"    # xoxb-...
export SLACK_APP_TOKEN="${SLACK_APP_TOKEN:-$(op read op://secrets/herdr-slack-bridge-app/credential)}"    # xapp-...

# REQUIRED — your Slack member id(s), comma-separated. Fail-closed: only these
# users' messages are delivered. Get it in Slack: your avatar -> Profile ->
# (…) menu -> Copy member ID.
export HERDR_BRIDGE_ALLOW_USERS="U00000000"

# STRONGLY RECOMMENDED — bind the allowlist above to ONE workspace. Slack member
# ids are unique per workspace, not globally: without this, a user carrying the
# same id in another workspace (e.g. via a Slack Connect channel) passes the
# allowlist, which is the only authentication this bridge has. The daemon warns
# at startup while this is unset. Get it with:
#   printf 'header = "Authorization: Bearer %s\n"' "$SLACK_BOT_TOKEN" \
#     | curl -s -X POST --config - https://slack.com/api/auth.test | jq -r .team_id
export HERDR_BRIDGE_TEAM="T00000000"

# OPTIONAL — restrict to a single channel id (else any channel the bot is in).
# export HERDR_BRIDGE_CHANNEL="C00000000"
