<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. install.sh --bridge substitutes __RUN_BRIDGE__ with the absolute
  path to slack-bridge/run-bridge.sh in your checkout and writes the result to
  ~/Library/LaunchAgents/com.herdr-control.bridge.plist.

  No secrets here: run-bridge.sh sources ~/.config/herdr-bridge.env, which
  references 1Password rather than storing tokens on disk.

  It sources ~/.config/op/service-account.env first (if you have one), because
  a launchd job that calls `op` DEADLOCKS: op probes Apple Events / AppData TCC
  on every invocation from a background session — regardless of
  OP_SERVICE_ACCOUNT_TOKEN — and there is no TTY to answer the prompt
  (1Password/shell-plugins#606). Measured 2026-09-06: token resolution hung
  until a 25s timeout without that file, 0.68s with it. Keep pre-resolved
  SLACK_BOT_TOKEN / SLACK_APP_TOKEN in it (chmod 600) and the daemon never
  spawns op at all; herdr-bridge.env.example's `:-` guards make the env win.
  The failure mode is silent: the daemon starts, never connects, and every
  alert and phone approval disappears.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.herdr-control.bridge</string>

  <!-- Three deliberate details, all from the security review of this PR:
       * the pre-resolved Slack tokens come from launchd-secrets.env, a file
         ONLY the plists that need it source — never ~/.zshenv, so a
         Slack-facing daemon and every non-interactive shell do not share one
         credential set;
       * OP_SERVICE_ACCOUNT_TOKEN is UNSET before exec. The daemon must never
         call `op` (that is this PR's whole point), and it forwards its whole
         environment to herdr-select.sh/herdr-deliver.sh on every button click,
         so carrying a vault-wide read credential into the one process that
         accepts remote input is privilege it does not need;
       * __RUN_BRIDGE__ is QUOTED. It is interpolated into a shell string now,
         not an argv element, so an unquoted checkout path containing a space
         would exec the wrong path and KeepAlive-loop forever. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>source "$HOME/.config/op/service-account.env" 2>/dev/null; source "$HOME/.config/op/launchd-secrets.env" 2>/dev/null; unset OP_SERVICE_ACCOUNT_TOKEN; exec "__RUN_BRIDGE__"</string>
  </array>

  <!-- launchd hands a job a minimal PATH. python3/herdr are in Homebrew and
       `op` is commonly in ~/.local/bin, which is on no default PATH at all. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Socket Mode holds a long-lived connection; restart it if it ever drops. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- ~/Library/Logs is per-user (0700 by default on macOS), unlike
       /tmp, which is world-writable-and-sticky: a co-resident local user
       could otherwise read the bridge's own startup banner (Slack member
       id allowlist, team/channel binding) or any traceback that surfaces
       agent pane content via the notify path. install.sh substitutes
       __LOG_PATH__ and creates the directory before loading this plist. -->
  <key>StandardOutPath</key>
  <string>__LOG_PATH__</string>
  <key>StandardErrorPath</key>
  <string>__LOG_PATH__</string>
</dict>
</plist>
